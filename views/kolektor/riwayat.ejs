<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Riwayat Setoran Kolektor | <%= appSettings.company_name || 'Tagihan WiFi' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 font-['Plus_Jakarta_Sans',sans-serif] min-h-screen pb-20 antialiased">

  <!-- Mobile Top Bar -->
  <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
    <div class="max-w-xl mx-auto px-4 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/kolektor/dashboard" class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-white text-sm">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h1 class="font-bold text-sm">Riwayat Pembayaran Diterima</h1>
      </div>
      <span class="text-xs text-amber-400 font-mono"><%= monthName %> <%= currentYear %></span>
    </div>
  </header>

  <main class="max-w-xl mx-auto px-4 pt-4 space-y-4">
    
    <!-- Total In Hand Banner -->
    <div class="bg-gradient-to-tr from-emerald-600 to-teal-700 text-white p-5 rounded-2xl shadow-lg">
      <span class="text-xs uppercase tracking-wider text-emerald-100 font-semibold block mb-1">Total Kas Yang Anda Pegang:</span>
      <div class="text-3xl font-black"><%= formatRupiah(totalCollected) %></div>
      <p class="text-xs text-emerald-100 mt-2 font-medium">
        <i class="fa-solid fa-circle-info mr-1"></i>
        Total dari <b><%= collections.length %></b> transaksi sukses periode ini. Siap disetorkan ke admin kasir.
      </p>
    </div>

    <!-- Collections List -->
    <div class="space-y-2.5">
      <% if (collections.length === 0) { %>
        <div class="bg-white rounded-2xl p-8 text-center border border-slate-200">
          <p class="text-xs text-slate-400">Belum ada penagihan yang selesai bulan ini.</p>
        </div>
      <% } %>

      <% collections.forEach(col => { %>
        <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between gap-3">
          <div class="space-y-0.5">
            <h4 class="font-extrabold text-xs text-slate-900"><%= col.customer_name %></h4>
            <p class="text-[11px] text-slate-400 font-mono"><%= col.invoice_no %> &bull; <%= formatDateTime(col.paid_at) %></p>
            <div class="flex items-center gap-2 pt-0.5">
              <span class="uppercase text-[9px] font-mono px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded font-bold">
                <%= col.payment_method || 'TUNAI' %>
              </span>
              <span class="text-[11px] text-slate-500 font-medium"><%= col.package_name %></span>
            </div>
          </div>

          <div class="text-right flex flex-col items-end gap-1.5">
            <span class="font-black text-sm text-emerald-600"><%= formatRupiah(col.amount) %></span>
            <a href="/kolektor/struk/<%= col.id %>" target="_blank" class="px-2 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-[10px] font-bold inline-flex items-center gap-1">
              <i class="fa-solid fa-print"></i> Struk
            </a>
          </div>
        </div>
      <% }) %>
    </div>

  </main>

</body>
</html>
