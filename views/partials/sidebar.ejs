<!-- Sidebar Overlay (Mobile) -->
<div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 hidden md:hidden"></div>

<!-- Sidebar Container -->
<aside id="sidebar" class="fixed top-0 bottom-0 left-0 w-64 bg-slate-900 text-white z-50 flex flex-col transition-transform duration-300 -translate-x-full md:translate-x-0 border-r border-slate-800 shadow-xl">
  
  <!-- Logo / Brand Header -->
  <div class="h-20 flex items-center px-6 border-b border-slate-800/80 bg-slate-950/40">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-brand-500/25">
        <i class="fa-solid fa-wifi text-lg"></i>
      </div>
      <div>
        <h1 class="font-bold text-base tracking-tight text-white line-clamp-1">
          <%= appSettings.company_name || 'WiFi Billing' %>
        </h1>
        <p class="text-xs text-brand-400 font-medium">Panel Administrator</p>
      </div>
    </div>
  </div>

  <!-- Navigation Menu -->
  <div class="flex-1 overflow-y-auto px-4 py-6 space-y-1.5 custom-scrollbar">
    <div class="px-3 pb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
      Menu Utama
    </div>

    <!-- 1. Dashboard -->
    <a href="/admin/dashboard" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'dashboard' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-gauge-high text-base"></i>
      </div>
      <span>Dashboard</span>
    </a>

    <!-- 2. Paket -->
    <a href="/admin/paket" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'paket' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-box-archive text-base"></i>
      </div>
      <span>Paket</span>
    </a>

    <!-- 3. Pelanggan -->
    <a href="/admin/pelanggan" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'pelanggan' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-users text-base"></i>
      </div>
      <span>Pelanggan</span>
    </a>

    <!-- 4. Kolektor -->
    <a href="/admin/kolektor" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'kolektor' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-motorcycle text-base"></i>
      </div>
      <span>Kolektor</span>
    </a>

    <!-- Tagihan (Manajemen Status Lunas / Belum) -->
    <a href="/admin/tagihan" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'tagihan' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-file-invoice-dollar text-base"></i>
      </div>
      <span>Tagihan & Kas</span>
    </a>

    <!-- Laporan Transaksi Kolektor (Pertanggal) -->
    <a href="/admin/laporan-kolektor" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'laporan' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-chart-line text-base"></i>
      </div>
      <span>Laporan Kolektor</span>
    </a>

    <div class="pt-5 px-3 pb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
      Konfigurasi
    </div>

    <!-- 5. Pengaturan -->
    <a href="/admin/pengaturan" 
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 <%= activePage === 'pengaturan' ? 'bg-brand-600 text-white shadow-lg shadow-brand-600/30 font-semibold' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
      <div class="w-7 text-center">
        <i class="fa-solid fa-sliders text-base"></i>
      </div>
      <span>Pengaturan</span>
    </a>

    <!-- Quick link to view Collector Portal for testing -->
    <a href="/kolektor/login" target="_blank"
       class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-amber-400 hover:bg-slate-800/80 hover:text-amber-300 transition-all duration-200">
      <div class="w-7 text-center">
        <i class="fa-solid fa-mobile-screen-button text-base"></i>
      </div>
      <span class="flex-1">Portal Kolektor</span>
      <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-70"></i>
    </a>
  </div>

  <!-- Footer Profile & Armbian/SQLite status -->
  <div class="p-4 border-t border-slate-800/80 bg-slate-950/50">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-[11px] font-semibold text-slate-400">SQLite WAL Active</span>
      </div>
      <span class="text-[10px] bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded font-mono">Armbian</span>
    </div>

    <div class="flex items-center justify-between pt-2 border-t border-slate-800/60">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-slate-300 font-bold text-xs uppercase">
          <%= (user && user.name) ? user.name.charAt(0) : 'A' %>
        </div>
        <div class="text-left">
          <p class="text-xs font-semibold text-white leading-tight"><%= (user && user.name) || 'Admin' %></p>
          <p class="text-[10px] text-slate-400 capitalize"><%= (user && user.role) || 'Administrator' %></p>
        </div>
      </div>
      <a href="/logout" title="Keluar" class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-rose-500/20 hover:text-rose-400 transition-colors">
        <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
      </a>
    </div>
  </div>
</aside>
