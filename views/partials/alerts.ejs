<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="mb-6 flex items-center justify-between p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm animate-fade-in" role="alert">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
        <i class="fa-solid fa-circle-check text-base"></i>
      </div>
      <div>
        <p class="text-sm font-semibold"><%= success %></p>
      </div>
    </div>
    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="mb-6 flex items-center justify-between p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 shadow-sm animate-fade-in" role="alert">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-rose-100 flex items-center justify-center text-rose-600 flex-shrink-0">
        <i class="fa-solid fa-circle-exclamation text-base"></i>
      </div>
      <div>
        <p class="text-sm font-semibold"><%= error %></p>
      </div>
    </div>
    <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
  </div>
<% } %>
