<%- include('../../partials/head') %>

<div class="min-h-screen flex">
  <%- include('../../partials/sidebar') %>

  <div class="flex-1 md:pl-64 flex flex-col min-w-0">
    <%- include('../../partials/navbar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 bg-slate-50/60">
      <div class="max-w-7xl mx-auto space-y-6">

        <%- include('../../partials/alerts') %>

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
          <div>
            <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
              <i class="fa-solid fa-motorcycle text-brand-600"></i>
              <span>Manajemen Petugas Kolektor</span>
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">Kelola akun petugas lapangan, area penugasan, dan pantau setoran</p>
          </div>

          <div class="flex items-center gap-2.5">
            <!-- Period Selector -->
            <form action="/admin/kolektor" method="GET" class="flex items-center gap-1.5">
              <select name="month" onchange="this.form.submit()" class="px-2.5 py-1.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold focus:outline-none">
                <% for(let m=1; m<=12; m++) { %>
                  <option value="<%= m %>" <%= currentMonth === m ? 'selected' : '' %>><%= m %> - <%= ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'][m-1] %></option>
                <% } %>
              </select>
              <select name="year" onchange="this.form.submit()" class="px-2.5 py-1.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold focus:outline-none">
                <% for(let y=currentYear-1; y<=currentYear+1; y++) { %>
                  <option value="<%= y %>" <%= currentYear === y ? 'selected' : '' %>><%= y %></option>
                <% } %>
              </select>
            </form>

            <button onclick="openAddCollectorModal()" class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold shadow-sm transition">
              <i class="fa-solid fa-user-plus"></i>
              <span>Tambah Kolektor</span>
            </button>
          </div>
        </div>

        <!-- Collectors Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          <% collectors.forEach(col => { 
            const total = (col.lunas_count || 0) + (col.belum_count || 0);
            const percent = total > 0 ? Math.round((col.lunas_count / total) * 100) : 0;
          %>
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 hover:border-brand-400 hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <!-- Top Info -->
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-lg font-bold">
                      <i class="fa-solid fa-motorcycle"></i>
                    </div>
                    <div>
                      <h4 class="font-extrabold text-slate-900 text-base leading-tight"><%= col.name %></h4>
                      <p class="text-xs text-slate-400 font-mono">@<%= col.username %></p>
                    </div>
                  </div>
                  <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold <%= col.is_active ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-500' %>">
                    <%= col.is_active ? 'Aktif' : 'Non-Aktif' %>
                  </span>
                </div>

                <!-- Area & Phone -->
                <div class="space-y-1.5 text-xs text-slate-600 bg-slate-50 p-3 rounded-xl border border-slate-100 mb-4">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-map-location-dot text-slate-400 w-4 text-center"></i>
                    <span class="font-semibold text-slate-700"><%= col.area || 'Wilayah Umum' %></span>
                  </div>
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-phone text-slate-400 w-4 text-center"></i>
                    <span><%= col.phone || '-' %></span>
                  </div>
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-users text-slate-400 w-4 text-center"></i>
                    <span><b><%= col.total_customers %></b> Pelanggan Terdaftar</span>
                  </div>
                </div>

                <!-- Performance Progress for current month -->
                <div class="space-y-2">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-500">Penagihan <%= monthName %>:</span>
                    <span class="font-bold text-emerald-600"><%= formatRupiah(col.total_collected) %></span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                    <div class="bg-amber-500 h-2 rounded-full transition-all" style="width: <%= percent %>%"></div>
                  </div>
                  <div class="flex items-center justify-between text-[11px] text-slate-400">
                    <span>Lunas: <b><%= col.lunas_count %></b></span>
                    <span class="text-rose-500">Belum: <b><%= col.belum_count %></b></span>
                    <span><%= percent %>% Selesai</span>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
                <a href="/admin/kolektor/<%= col.id %>" class="flex-1 py-1.5 px-3 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs transition text-center">
                  <i class="fa-solid fa-chart-simple mr-1"></i> Performa
                </a>
                <button type="button" onclick="openEditCollectorModal('<%= col.id %>', '<%= col.name %>', '<%= col.phone %>', '<%= col.area %>', '<%= col.is_active %>')"
                        class="p-1.5 rounded-lg text-slate-500 hover:bg-slate-100 transition" title="Edit Data">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <form action="/admin/kolektor/<%= col.id %>/delete" method="POST" onsubmit="return confirm('Hapus kolektor <%= col.name %>? Pelanggan akan menjadi tanpa kolektor.')" class="inline">
                  <button type="submit" class="p-1.5 rounded-lg text-rose-500 hover:bg-rose-50 transition" title="Hapus Kolektor">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        </div>

      </div>
    </main>
  </div>
</div>

<!-- Modal Tambah Kolektor -->
<div id="addCollectorModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h4 class="text-sm font-bold text-slate-800">Tambah Petugas Kolektor</h4>
      <button onclick="closeAddCollectorModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <form action="/admin/kolektor" method="POST" class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Petugas *</label>
        <input type="text" name="name" required placeholder="Contoh: Budi Santoso" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Username Login *</label>
          <input type="text" name="username" required placeholder="kolektor3" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Password *</label>
          <input type="password" name="password" required placeholder="••••••••" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">No. WhatsApp / HP</label>
        <input type="text" name="phone" placeholder="081234567890" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Wilayah / Area Penugasan</label>
        <input type="text" name="area" placeholder="Contoh: RT 01 - 03 RW 04" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div class="mt-5 flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeAddCollectorModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-sm">Daftarkan Kolektor</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Kolektor -->
<div id="editCollectorModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h4 class="text-sm font-bold text-slate-800">Edit Petugas Kolektor</h4>
      <button onclick="closeEditCollectorModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <form id="editCollectorForm" method="POST" class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Petugas *</label>
        <input type="text" id="editColName" name="name" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">No. WhatsApp / HP</label>
        <input type="text" id="editColPhone" name="phone" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Wilayah / Area Penugasan</label>
        <input type="text" id="editColArea" name="area" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Reset Password Baru (Kosongkan jika tidak diganti)</label>
        <input type="password" name="password" placeholder="Biarkan kosong jika tidak ganti" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div class="flex items-center gap-2 pt-1">
        <input type="checkbox" id="editColActive" name="is_active" value="1" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500">
        <label for="editColActive" class="text-xs font-semibold text-slate-700">Akun Kolektor Aktif</label>
      </div>

      <div class="mt-5 flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeEditCollectorModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-sm">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddCollectorModal() {
    const modal = document.getElementById('addCollectorModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeAddCollectorModal() {
    const modal = document.getElementById('addCollectorModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function openEditCollectorModal(id, name, phone, area, isActive) {
    const modal = document.getElementById('editCollectorModal');
    document.getElementById('editCollectorForm').action = `/admin/kolektor/${id}/update`;
    document.getElementById('editColName').value = name;
    document.getElementById('editColPhone').value = phone;
    document.getElementById('editColArea').value = area;
    document.getElementById('editColActive').checked = (isActive == 1);

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeEditCollectorModal() {
    const modal = document.getElementById('editCollectorModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>

<%- include('../../partials/footer') %>
