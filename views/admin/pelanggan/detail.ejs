<%- include('../../partials/head') %>

<div class="min-h-screen flex">
  <%- include('../../partials/sidebar') %>

  <div class="flex-1 md:pl-64 flex flex-col min-w-0">
    <%- include('../../partials/navbar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 bg-slate-50/60">
      <div class="max-w-7xl mx-auto space-y-6">

        <%- include('../../partials/alerts') %>

        <!-- Breadcrumb & Back -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
            <a href="/admin/pelanggan" class="hover:text-brand-600 transition flex items-center gap-1">
              <i class="fa-solid fa-arrow-left"></i>
              <span>Kembali ke Pelanggan</span>
            </a>
            <span>/</span>
            <span class="text-slate-800">Detail Pelanggan</span>
          </div>

          <button onclick="openEditModal()" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
            <i class="fa-solid fa-pen-to-square mr-1"></i> Edit Pelanggan
          </button>
        </div>

        <!-- Customer Profile Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-100">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-600 flex items-center justify-center text-white text-xl font-bold shadow-md shadow-brand-500/20">
                <%= customer.name.charAt(0) %>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-extrabold text-slate-900"><%= customer.name %></h3>
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold <%= customer.status === 'aktif' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : (customer.status === 'isolir' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-slate-100 text-slate-600') %>">
                    <%= customer.status.toUpperCase() %>
                  </span>
                </div>
                <p class="text-xs font-mono text-slate-400 mt-0.5">Kode: <b class="text-slate-700"><%= customer.customer_code %></b> &bull; Pasang: <%= formatDate(customer.installation_date) %></p>
              </div>
            </div>

            <!-- Quick WhatsApp & Call -->
            <div class="flex flex-wrap items-center gap-2">
              <a href="https://wa.me/<%= customer.phone.replace(/[^0-9]/g, '') %>" target="_blank"
                 class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold hover:bg-emerald-100 transition">
                <i class="fa-brands fa-whatsapp text-sm text-emerald-600"></i>
                <span>Hubungi WA</span>
              </a>
              <a href="tel:<%= customer.phone %>"
                 class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition">
                <i class="fa-solid fa-phone text-xs"></i>
                <span><%= customer.phone %></span>
              </a>
            </div>
          </div>

          <!-- Profile Details Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-6 text-xs">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 font-semibold block mb-1">Paket Internet:</span>
              <p class="text-sm font-bold text-slate-800"><%= customer.package_name %> (<%= customer.package_speed %>)</p>
              <p class="text-brand-600 font-bold mt-0.5"><%= formatRupiah(customer.package_price) %>/bulan</p>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 font-semibold block mb-1">Kolektor Lapangan:</span>
              <p class="text-sm font-bold text-slate-800"><%= customer.collector_name || 'Tanpa Petugas Kolektor' %></p>
              <p class="text-slate-500 mt-0.5"><%= customer.collector_phone || '-' %></p>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 font-semibold block mb-1">Tgl Jatuh Tempo:</span>
              <p class="text-sm font-bold text-slate-800">Setiap Tanggal <%= customer.due_date || 10 %></p>
              <p class="text-slate-500 mt-0.5">IP: <%= customer.ip_address || 'DHCP Dynamic' %></p>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 font-semibold block mb-1">Alamat Pemasangan:</span>
              <p class="text-xs font-semibold text-slate-800 leading-relaxed"><%= customer.address || 'Alamat belum diisi.' %></p>
              <% if (customer.notes) { %>
                <p class="text-[11px] text-slate-400 mt-1 italic">"<%= customer.notes %>"</p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Billing History (Lunas vs Belum Lunas) -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <div>
              <h4 class="text-sm font-bold text-slate-800">Riwayat Tagihan Pelanggan</h4>
              <p class="text-xs text-slate-400">Daftar seluruh tagihan bulanan beserta status pelunasan</p>
            </div>
            <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1 rounded-xl">
              Total: <%= bills.length %> Tagihan
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-50/80 text-[11px] font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200/70">
                  <th class="py-3 px-4">No. Invoice</th>
                  <th class="py-3 px-4">Periode</th>
                  <th class="py-3 px-4">Nominal</th>
                  <th class="py-3 px-4 text-center">Status</th>
                  <th class="py-3 px-4">Tgl Bayar & Metode</th>
                  <th class="py-3 px-4">Petugas Penerima</th>
                  <th class="py-3 px-4 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-xs">
                <% if (bills.length === 0) { %>
                  <tr>
                    <td colspan="7" class="py-8 text-center text-slate-400">
                      Belum ada tagihan untuk pelanggan ini.
                    </td>
                  </tr>
                <% } %>

                <% bills.forEach(b => { %>
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-3.5 px-4 font-mono font-bold text-slate-800"><%= b.invoice_no %></td>
                    <td class="py-3.5 px-4 font-semibold text-slate-700"><%= getMonthName(b.period_month) %> <%= b.period_year %></td>
                    <td class="py-3.5 px-4 font-bold text-slate-900"><%= formatRupiah(b.amount) %></td>
                    <td class="py-3.5 px-4 text-center">
                      <% if (b.status === 'lunas') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          <i class="fa-solid fa-circle-check"></i> LUNAS
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                          <i class="fa-solid fa-clock"></i> BELUM LUNAS
                        </span>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-4">
                      <% if (b.status === 'lunas') { %>
                        <div class="font-semibold text-slate-700"><%= formatDateTime(b.paid_at) %></div>
                        <span class="text-[10px] text-slate-400 uppercase font-mono"><%= b.payment_method || 'TUNAI' %></span>
                      <% } else { %>
                        <span class="text-slate-400 italic">Menunggu Pembayaran</span>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-4 text-slate-600">
                      <%= b.collector_name || (b.status === 'lunas' ? 'Admin Langsung' : '-') %>
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <% if (b.status === 'lunas') { %>
                        <a href="/admin/tagihan/<%= b.id %>/struk" target="_blank" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[11px] transition inline-flex items-center gap-1">
                          <i class="fa-solid fa-print"></i> Struk
                        </a>
                      <% } else { %>
                        <button type="button" onclick="openBillPayModal('<%= b.id %>', '<%= customer.name %>', '<%= b.amount %>')"
                                class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm transition">
                          Bayar
                        </button>
                      <% } %>
                      <form action="/admin/tagihan/<%= b.id %>/hapus" method="POST" onsubmit="return confirm('Hapus tagihan <%= b.invoice_no %>?')" class="inline-block ml-1">
                        <button type="submit" title="Hapus Tagihan" class="p-1 rounded-lg text-slate-400 hover:text-rose-600 transition">
                          <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>
  </div>
</div>

<!-- Modal Edit Pelanggan -->
<div id="editCustomerModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h4 class="text-sm font-bold text-slate-800">Edit Data Pelanggan</h4>
      <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <form action="/admin/pelanggan/<%= customer.id %>/update" method="POST" class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap Pelanggan *</label>
        <input type="text" name="name" value="<%= customer.name %>" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">No. WhatsApp / HP *</label>
          <input type="text" name="phone" value="<%= customer.phone %>" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tgl Jatuh Tempo</label>
          <input type="number" name="due_date" value="<%= customer.due_date || 10 %>" min="1" max="28" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Paket Internet *</label>
          <select name="package_id" required class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <% packages.forEach(pkg => { %>
              <option value="<%= pkg.id %>" <%= customer.package_id == pkg.id ? 'selected' : '' %>><%= pkg.name %> (<%= pkg.speed %> - <%= formatRupiah(pkg.price) %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Kolektor Penanggung Jawab</label>
          <select name="collector_id" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="">-- Tanpa Kolektor --</option>
            <% collectors.forEach(c => { %>
              <option value="<%= c.id %>" <%= customer.collector_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Alamat Lengkap</label>
        <textarea name="address" rows="2" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none"><%= customer.address %></textarea>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Status Akun</label>
          <select name="status" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="aktif" <%= customer.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
            <option value="isolir" <%= customer.status === 'isolir' ? 'selected' : '' %>>Isolir</option>
            <option value="nonaktif" <%= customer.status === 'nonaktif' ? 'selected' : '' %>>Non-Aktif</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">IP Address / Info ONT</label>
          <input type="text" name="ip_address" value="<%= customer.ip_address %>" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Catatan Tambahan</label>
        <input type="text" name="notes" value="<%= customer.notes %>" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
      </div>

      <div class="mt-5 flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeEditModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-sm">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Bayar Tagihan -->
<div id="billPayModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
      <h4 class="text-sm font-bold text-slate-800">Catat Pembayaran</h4>
      <button onclick="closeBillPayModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
    </div>
    
    <form id="billPayForm" method="POST">
      <div class="space-y-3">
        <div>
          <p class="text-xs text-slate-500">Nama Pelanggan:</p>
          <p id="bpName" class="text-sm font-bold text-slate-800">-</p>
        </div>
        <div>
          <p class="text-xs text-slate-500">Nominal Tagihan:</p>
          <p id="bpAmount" class="text-base font-extrabold text-emerald-600">-</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Metode Bayar</label>
          <select name="payment_method" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="tunai">Tunai / Cash</option>
            <option value="transfer">Transfer Bank</option>
            <option value="qris">QRIS / E-Wallet</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Kolektor Penerima</label>
          <select name="collected_by" class="w-full px-3 py-2 border border-slate-300 rounded-xl text-xs font-medium focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="">Admin Langsung (Pusat)</option>
            <% collectors.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button" onclick="closeBillPayModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200">Batal</button>
        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm">Set LUNAS</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditModal() {
    const modal = document.getElementById('editCustomerModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeEditModal() {
    const modal = document.getElementById('editCustomerModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function openBillPayModal(billId, name, amount) {
    const modal = document.getElementById('billPayModal');
    document.getElementById('billPayForm').action = `/admin/tagihan/${billId}/bayar`;
    document.getElementById('bpName').innerText = name;
    document.getElementById('bpAmount').innerText = 'Rp ' + Number(amount).toLocaleString('id-ID');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeBillPayModal() {
    const modal = document.getElementById('billPayModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>

<%- include('../../partials/footer') %>
